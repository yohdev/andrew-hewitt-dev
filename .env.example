# ---------------------------------------------------------------------------
# Public site config (safe to expose to the browser — NEXT_PUBLIC_*)
# Copy to `.env.local` and fill in. All are optional; sensible fallbacks apply.
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://andrewhewitt.dev

# Booking / scheduler link every "Book a call" CTA points to.
# Swap the placeholder for a real scheduler (Calendly / cal.com / contact form).
NEXT_PUBLIC_BOOKING_URL=https://andrewhewitt.dev

# Contact email used for the "prefer email?" fallback.
NEXT_PUBLIC_CONTACT_EMAIL=hello@andrewhewitt.dev

# Optional analytics id (no-op when unset). Wire a provider in lib/analytics later.
# NEXT_PUBLIC_ANALYTICS_ID=

# ---------------------------------------------------------------------------
# Server-only secrets (NEVER prefixed NEXT_PUBLIC). Add here when a CMS/API is
# introduced — e.g. Sanity project id/token. See CLAUDE.md > "Maturing the site".
# ---------------------------------------------------------------------------
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=
